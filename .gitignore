node_modules/

# Build output
# dist/ — ESM build from tsc (not committed, rebuild with `npm run build:cli`)
dist/
# dist-action/ — esbuild CJS bundle for GitHub Actions (committed, rebuild with `npm run build`)
# Keep dist-action/ tracked; only ignore its node_modules
dist-action/node_modules/

# Tool build outputs (standalone tools don't need committed builds)
tool-test-action-on-github/evaluate/dist/

*.log
.env
.DS_Store
coverage/
docs/_build/
.vscode/
.idea/

# TypeScript build info
*.tsbuildinfo

# No scratch location in the tree (D-2026-09-21-no-scratch-in-tree in .qe/dev/decisions/);
# legacy locations stay ignored so stale local copies remain invisible
.tmp/
**/*.tmp
.cache/

# Generated reports (output of CLI tools)
/reports/

# Test repositories (cloned locally for testing)
# Globbed, not enumerated: adding a language is meant to be one line in the
# harness's LANGUAGES array, and an enumerated list makes .gitignore a fourth
# file to remember. ml was added without one, so a real run would have left an
# embedded clone that `git add -A` stages as a gitlink.
test-translation-sync*/
tool-test-action-on-github/test-translation-sync*/

# Python bytecode (experiments/ carry .py analysis scripts)
__pycache__/
*.pyc
